# Copy this file to .env for local development.
# Values in this file are safe placeholders only; do not use them in production.

# inference service
RTSP_URL=
DETECTION_INTERVAL_SECONDS=45
YOLO_MODEL_PATH=yolov8n.pt
MOCK_MODE=true
MOCK_FRAME_PATH=dataset/mock/workspace.ppm

# backend API
DATABASE_URL=postgresql://basirai:basirai-local-only@db:5432/basirai
BACKEND_API_KEY=local-development-key

# PostgreSQL container defaults (local development only)
POSTGRES_DB=basirai
POSTGRES_USER=basirai
POSTGRES_PASSWORD=basirai-local-only
POSTGRES_PORT=5432

# object storage (optional for local mode)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
