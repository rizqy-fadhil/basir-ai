# Copy this file to .env for local development.
# Values in this file are safe placeholders only; do not use them in production.

# inference service — runtime occupancy
RTSP_URL=
DETECTION_INTERVAL_SECONDS=45
YOLO_PERSON_MODEL_PATH=yolov8n.pt
YOLO_PERSON_CLASS_ID=0
YOLO_PERSON_CONFIDENCE_THRESHOLD=0.40
# Download the fine-tuned calibration asset from the documented release.
YOLO_CALIBRATION_MODEL_PATH=inference/models/table-chair-best.pt
YOLO_CALIBRATION_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
MOCK_MODE=true
MOCK_FRAME_PATH=dataset/mock/workspace.ppm

# backend API
DATABASE_URL=postgresql+psycopg://basirai:basirai-local-only@db:5432/basirai
BACKEND_API_KEY=local-development-key

# PostgreSQL container defaults (local development only)
POSTGRES_DB=basirai
POSTGRES_USER=basirai
POSTGRES_PASSWORD=basirai-local-only
POSTGRES_PORT=5432

# object storage (optional for local mode)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
